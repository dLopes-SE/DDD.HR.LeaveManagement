<EditForm Model="LeaveType" OnValidSubmit="OnValidSubmit">
  <DataAnnotationsValidator />
  <ValidationSummary />
  <fieldset disabled="@Disabled">
    <div class="form-group">
      <label for="Name">Name</label>
      <InputText id="Name" class="form-control" @bind-Value="LeaveType.Name" />
      <ValidationMessage For="@(() => LeaveType.Name)" />
    </div>
    <div class="form-group">
      <label for="DefaultDays">DefaultDays</label>
      <InputNumber id="DefaultDays" class="form-control" @bind-Value="LeaveType.DefaultDays" />
      <ValidationMessage For="@(() => LeaveType.DefaultDays)" />
    </div>
    @if (!Disabled)
    {
      <button type="submit" class="btn btn-success">
        @ButtonText
      </button>
    }
  </fieldset>
  <BackToList Target="leavetypes" />
</EditForm>